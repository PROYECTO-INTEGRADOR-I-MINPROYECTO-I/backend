# Copiar este archivo como .env y ajustar los valores según el entorno local.

# Entorno de ejecución: dev | qa | prod. Controla los defaults de DEBUG,
# SECRET_KEY y las cabeceras de seguridad.
ENVIRONMENT=dev

# Clave secreta de Django. En dev puede omitirse (hay un default inseguro),
# pero en qa/prod es obligatoria y no debe versionarse con un valor real.
SECRET_KEY=django-insecure-dev-key-cambiame

# Activa/desactiva el modo debug. En dev por defecto es True.
DEBUG=True

# Hosts permitidos, separados por coma. Ejemplo: localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# Cadena de conexión a la base de datos (Postgres). Si se omite, el proyecto
# usa SQLite localmente. Formato: postgres://usuario:password@host:puerto/nombre_db
DATABASE_URL=postgres://user:password@localhost:5432/postgres

# Orígenes permitidos para CORS, separados por coma (dominios del frontend).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Orígenes confiables para CSRF, separados por coma (mismos dominios del frontend, con esquema).
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# Correo. En dev los mensajes se imprimen en consola y no hace falta configurar nada.
# En qa/prod, si no se define EMAIL_HOST se usa un backend dummy que descarta los
# correos (y `manage.py check --deploy` lo reporta como pendiente).
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=no-reply@planificapp.local
